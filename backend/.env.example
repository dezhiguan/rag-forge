# 复制为 backend/.env 后按需修改（.env 已被 git 忽略）
# 生产/云端：Server 3 应用层通过私网连接 Server 1 数据层（172.25.90.183）

# PostgreSQL（Server 1 私网数据层）
POSTGRES_HOST=172.25.90.183
POSTGRES_PORT=5432
POSTGRES_DB=ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge

# Elasticsearch（Server 1 私网数据层）
ELASTICSEARCH_HOST=172.25.90.183
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-es-password

# RocketMQ（Server 1 私网数据层 NameServer）
ROCKETMQ_NAMESRV_ADDR=172.25.90.183:9876
ROCKETMQ_PRODUCER_GROUP=ragforge-producer

# Redis（本地开发默认 ECS 8.148.217.153；生产见 application-prod.yml 172.25.90.183）
REDIS_HOST=8.148.217.153
REDIS_PORT=6379

# 阿里云 DashScope（text-embedding-v4 + qwen-vl-max + multimodal-embedding-v1）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_VISION_ENDPOINT=
DASHSCOPE_IMAGE_EMBEDDING_ENDPOINT=

# T10 多模态运行参数
RAGFORGE_MULTIMODAL_ENABLED=true
RAGFORGE_MULTIMODAL_TIMEOUT_MS=30000
RAGFORGE_MULTIMODAL_MAX_CONCURRENT=1
RAGFORGE_EMBEDDED_IMAGE_MIN_BYTES=8192
RAGFORGE_EMBEDDED_IMAGE_MAX_CONCURRENT=3
RAGFORGE_EMBEDDED_IMAGE_MAX_PROCESSING_MS_PER_DOC=120000

# 阿里云 OSS（V5 ObjectStorage，AK/SK 不要写入代码仓库）
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_BUCKET=ragforge-dev
ALIYUN_OSS_AK=your-aliyun-oss-access-key-id
ALIYUN_OSS_SK=your-aliyun-oss-access-key-secret

# RAGForge 认证（Auth Gateway / JWT / JWKS）
# 本地没有 Auth Gateway 时，后台页面无法完成登录；仍可用 dev profile 的 sk-ragforge-dev 调试 /api/v1/search。
RAGFORGE_AUTH_ISSUER=https://auth.careermate.cn
RAGFORGE_AUTH_AUDIENCE=ragforge-admin-api
RAGFORGE_AUTH_JWKS_URL=http://127.0.0.1:8090/.well-known/jwks.json
RAGFORGE_AUTH_JWKS_CACHE_TTL_MS=3600000

# RAGForge -> Auth Gateway 代理
RAGFORGE_AUTH_PROXY_BASE_URL=http://127.0.0.1:8090
RAGFORGE_AUTH_PROXY_CLIENT_ID=ragforge-admin-backend
RAGFORGE_AUTH_PROXY_TARGET_AUDIENCE=ragforge-admin-api
RAGFORGE_AUTH_PROXY_TOKEN_ENDPOINT_AUDIENCE=https://auth.careermate.cn/oauth/token
RAGFORGE_AUTH_PROXY_CLIENT_ASSERTION_PRIVATE_KEY=
RAGFORGE_AUTH_PROXY_CLIENT_ASSERTION_KID=ragforge-admin-backend
RAGFORGE_AUTH_PROXY_PUBLIC_KEY_PEM=
RAGFORGE_AUTH_PROXY_COOKIE_SECURE=false

# Auth Gateway -> RAGForge 事件 webhook
# 必须与 auth-gateway event_subscriptions.hmac_secret 保持一致。
RAGFORGE_AUTH_EVENT_HMAC_SECRET=dev-secret-must-match-authgw
RAGFORGE_AUTH_EVENT_SIGNATURE_HEADER=X-Auth-Event-Signature
RAGFORGE_AUTH_EVENT_TIMESTAMP_HEADER=X-Auth-Event-Timestamp
RAGFORGE_AUTH_EVENT_IDEMPOTENCY_TTL=7d
RAGFORGE_AUTH_REVOKED_JTI_TTL=7d
RAGFORGE_AUTH_USER_REVOCATION_TTL=30d

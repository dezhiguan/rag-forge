# 复制为 backend/.env 后按需修改（.env 已被 git 忽略）

# PostgreSQL（本机 Postgres.app / 本地安装，默认 5432）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ragforge
POSTGRES_USER=amy
POSTGRES_PASSWORD=amy

# Elasticsearch（ECS 公网 IP，需开放 9200 与安全组）
ELASTICSEARCH_HOST=8.163.63.222
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-es-password

# RocketMQ（本机 NameServer）
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=ragforge-producer

SPRING_PROFILES_ACTIVE=prod
SPRING_OUTPUT_ANSI_ENABLED=always
JAVA_OPTS=-Xms512m -Xmx1g

# Business vs framework log levels (console + SkyWalking business logger)
APP_LOG_LEVEL=INFO
FRAMEWORK_LOG_LEVEL=WARN

# SkyWalking Java Agent (install to /opt/skywalking-agent on Server 3)
SKYWALKING_AGENT_SERVICE_NAME=ragforge-backend
SKYWALKING_COLLECTOR_BACKEND_SERVICE=172.25.90.184:11800
JAVA_TOOL_OPTIONS=-javaagent:/opt/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=ragforge-backend -Dskywalking.collector.backend_service=172.25.90.184:11800

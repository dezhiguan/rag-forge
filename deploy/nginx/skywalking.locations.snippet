# SkyWalking UI — merge into each ingress server block BEFORE catch-all `location /`.
# OAP/UI runs on Server 3; ingress Nginx (Server 2) proxies over private network.
# UI context path is /skywalking (see careermate deploy/skywalking/docker-compose.skywalking.yml).
#
# SkyWalking UI 10.x serves HTML under /skywalking/ but references root-absolute asset paths
# (/static/, /graphql, /monacoeditorwork/). Proxy those paths to the UI upstream — do NOT use
# a local alias for hashed chunk files (they change on every UI upgrade).

location = /skywalking {
    return 301 /skywalking/;
}

location /skywalking/ {
    proxy_pass http://172.25.90.184:18088/skywalking/;
    # Explicit upstream host — do not forward the client Host request header.
    proxy_set_header Host 172.25.90.184;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}

location ^~ /static/ {
    proxy_pass http://172.25.90.184:18088/static/;
    proxy_set_header Host 172.25.90.184;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store";
    proxy_read_timeout 300s;
}

location ^~ /monacoeditorwork/ {
    proxy_pass http://172.25.90.184:18088/monacoeditorwork/;
    proxy_set_header Host 172.25.90.184;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}

location = /graphql {
    proxy_pass http://172.25.90.184:18088/graphql;
    proxy_set_header Host 172.25.90.184;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}

location = /favicon.ico {
    proxy_pass http://172.25.90.184:18088/favicon.ico;
    proxy_set_header Host 172.25.90.184;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}

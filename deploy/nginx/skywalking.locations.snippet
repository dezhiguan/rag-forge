# SkyWalking UI — merge into each ingress server block BEFORE catch-all `location /`.
# OAP/UI runs on Server 3; ingress Nginx (Server 2) proxies over private network.
# UI context path is /skywalking (see careermate deploy/skywalking/docker-compose.skywalking.yml).

location /skywalking/ {
    proxy_pass http://172.25.90.184:18088/skywalking/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
}
